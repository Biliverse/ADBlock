name: "{{@package 'displayName'}}"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{this}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{version}}"

http:
  mitm:
    - "biliverse.github.io"
    - "manga.bilibili.com"
    - "api.live.bilibili.com"
    - "api.vc.bilibili.com"
    - "app.bilibili.com"
    - "app.biliapi.net"
    - "app.biliapi.com"
    - "api.bilibili.com"
    - "api.biliapi.net"
    - "grpc.biliapi.net"
    - "cm.bilibili.com"
    - "adtrack.qianwen.com"
    - "tkio-redirect.solar-engine.com"
  url-rewrite:
    # 去除搜索中的大家都在搜
    - ^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words - reject-dict
    # 去除动态中的话题
    - ^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr - reject-dict
    # 去除动态中的最常访问
    - ^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist - reject-dict
    # BiliBili漫画去广告
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash - reject-dict
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash - reject-dict
    - ^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? - reject-dict
  script:
    - match: ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/configs\/ADBlock(?:\?.*)?$
      name: PreferencePanes.Config.ADBlock
      type: request
      require-body: false
    - match: ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/(?:api\/(?:get|set|delete)|settings\/(?:[a-zA-Z0-9_-]+\/?|assets\/app\.mjs))(?:\?.*)?$
      name: PreferencePanes.API
      type: request
      require-body: true
      max-size: 65536
    - match: ^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$
      name: 📺 BiliBili.ADBlock.request.grpc
      type: request
      require-body: false
      binary-mode: true
      argument:
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?
      name: 📺 BiliBili.ADBlock.request.json
      type: request
      require-body: false
      argument:
    - match: ^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/)
      name: 📺 BiliBili.ADBlock.request.json
      type: request
      require-body: false
      argument:
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/(relate\/)?story)?|search\/square)
      name: 📺 BiliBili.ADBlock.response.json
      type: response
      require-body: true
      argument:
    - match: ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/(web-interface\/wbi\/index\/top\/feed\/rcmd|vip\/ads\/materials)\?
      name: 📺 BiliBili.ADBlock.response.json
      type: response
      require-body: true
      argument:
    - match: ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/page\/(bangumi|cinema\/tab\?)
      name: 📺 BiliBili.ADBlock.response.json
      type: response
      require-body: true
      argument:
    - match: ^https?:\/\/api\.live\.bilibili\.com\/xlive\/(app-room\/v1\/index\/getInfoByRoom|app-interface\/v2\/(index\/feed|room\/recList))
      name: 📺 BiliBili.ADBlock.response.json
      type: response
      require-body: true
      argument:
    - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.(view\.v1\.View\/(View|TFInfo|RelatesFeed|PlayerRelates|ViewProgress)|viewunite\.v1\.View\/(View|RelatesFeed|ViewProgress|PlayPause|ViewEndPage)|playerunite\.v1\.Player\/PlayViewUnite)$
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      max-size: 262144
      argument:
    - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)(Personal)?$
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile)
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v1\.Reply\/(MainList|DetailList|ReplyInfo)$
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v2\.Reply\/SubjectDescription$
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:
    - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$
      name: 📺 BiliBili.ADBlock.response.grpc
      type: response
      require-body: true
      binary-mode: true
      argument:

script-providers:
  PreferencePanes.Config.ADBlock:
    url: https://gist.githubusercontent.com/VirgilClyne/0b0c5ac2b8977d5461d4b3276d120896/raw/config.dev.bundle.js
    interval: 86400
  PreferencePanes.API:
    url: https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
    interval: 86400
  📺 BiliBili.ADBlock.request.grpc:
    url: https://gist.githubusercontent.com/VirgilClyne/0b0c5ac2b8977d5461d4b3276d120896/raw/request.dev.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.request.json:
    url: https://gist.githubusercontent.com/VirgilClyne/0b0c5ac2b8977d5461d4b3276d120896/raw/request.dev.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.response.json:
    url: https://gist.githubusercontent.com/VirgilClyne/0b0c5ac2b8977d5461d4b3276d120896/raw/response.dev.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.response.grpc:
    url: https://gist.githubusercontent.com/VirgilClyne/0b0c5ac2b8977d5461d4b3276d120896/raw/response.dev.bundle.js
    interval: 86400
