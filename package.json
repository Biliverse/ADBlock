{
	"name": "@biliverse/adblock",
	"organizationName": "🪐 Biliverse",
	"displayName": "📺 BiliBili: 🛡️ ADBlock",
	"description": "哔哩哔哩：去广告\n自定义去除APP内界面元素",
	"homepage": "https://biliverse.github.io/guide/ad-block",
	"openUrl": "http://boxjs.com/#/app/BiliBili.ADBlock",
	"icon": "https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png",
	"keywords": [],
	"contributors": [
		"ClydeTime[https://github.com/ClydeTime]",
		"VirgilClyne[https://github.com/VirgilClyne]",
		"app2smile[https://github.com/app2smile]",
		"RuCu6[https://github.com/RuCu6]",
		"Maasea[https://github.com/Maasea]"
	],
	"system": [
		"iOS",
		"iPadOS"
	],
	"systemVersion": 15,
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Biliverse/ADBlock.git"
	},
	"directories": {
		"example": "example"
	},
	"scripts": {
		"dev": "BUILD_VERSION=dev.$(git rev-parse --short HEAD) npm-run-all --serial build:dev-args build:dev",
		"dev:pages": "npx wrangler pages dev --port 8787",
		"dev:workers": "npx wrangler dev -c wrangler.workers.jsonc",
		"deploy:pages": "npx wrangler pages deploy",
		"deploy:workers": "npx wrangler deploy --minify -c wrangler.workers.jsonc",
		"vercel:dev": "bunx vercel dev",
		"vercel:deploy": "bunx vercel deploy --prod",
		"wrangler:dev": "bunx wrangler dev",
		"wrangler:deploy": "bunx wrangler deploy --minify",
		"build": "npm-run-all --serial build:args build:scripts",
		"build:scripts": "rollup -c",
		"build:dev": "rollup -c rollup.dev.config.mjs",
		"build:dev-args": "arguments-builder build -c arguments-builder.dev.config.ts",
		"build:release-args": "arguments-builder build -c arguments-builder.release.config.ts",
		"build:full-args": "arguments-builder boxjs -c arguments-builder.full.config.ts",
		"build:args:rewrite": "arguments-builder build -c arguments-builder.rewrite.config.ts",
		"build:args": "npm-run-all --serial build:release-args build:full-args",
		"test": "node --test tests/*.test.mjs",
		"dts": "arguments-builder dts -c arguments-builder.full.config.ts",
		"submodule": "git submodule update --remote",
		"update": "npm update --save"
	},
	"browserslist": [
		"iOS >= 15"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@iringo/arguments-builder": "^1.8.5",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"npm-run-all": "^4.1.5",
		"rollup": "^4.63.1",
		"typescript": "^5.9.3",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"@auraflare/shared": "^1.1.1",
		"@nsnanocat/grpc": "^1.1.0",
		"@nsnanocat/util": "^2.7.4",
		"@protobuf-ts/runtime": "^2.11.1",
		"crypto-js": "^4.2.0",
		"fetch-cookie": "^3.2.0",
		"hono": "^4.13.5"
	}
}
